<div class="cv-entry-list">
  {% for entry in entries %}
    {% capture entry_has_content %}{% include cv/has_content.liquid entry=entry %}{% endcapture %}
    {% assign entry_has_content = entry_has_content | strip %}
    {% if entry_has_content == 'true' %}
      {% if entry.bullet %}
        {% include cv/entry.liquid entry=entry summary=entry.bullet %}
      {% elsif entry.label %}
        {% include cv/entry.liquid entry=entry title=entry.label summary=entry.details %}
      {% else %}
        {% include cv/entry.liquid entry=entry %}
      {% endif %}
    {% endif %}
  {% endfor %}
</div>
