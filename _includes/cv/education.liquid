<div class="cv-entry-list">
  {% for entry in entries %}
    {% capture entry_has_content %}{% include cv/has_content.liquid entry=entry %}{% endcapture %}
    {% assign entry_has_content = entry_has_content | strip %}
    {% if entry_has_content == 'true' %}
      {% include cv/entry.liquid entry=entry title=entry.studyType organization=entry.institution subtitle=entry.area courses=entry.courses highlights=entry.highlights %}
    {% endif %}
  {% endfor %}
</div>
