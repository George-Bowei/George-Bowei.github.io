
---
layout: default
---

{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <p>CV rendering is unavailable.</p>
{% endif %}

<style>
/* CV: remove unwanted outer bullets */
.cv ul.list-group {
  list-style: none !important;
  padding-left: 0 !important;
}

.cv ul.list-group > li.list-group-item {
  display: block;
  list-style: none !important;
}

.cv ul.list-group > li.list-group-item::before {
  display: none !important;
}

/* CV: consistent date and content columns */
.cv ul.list-group > li.list-group-item > .row {
  display: grid !important;
  grid-template-columns: 135px minmax(0, 1fr);
  column-gap: 1.25rem;
  align-items: start;
  margin: 0 !important;
}

/* Reset inconsistent Bootstrap column spacing */
.cv ul.list-group > li.list-group-item > .row > [class*="col-"] {
  width: auto !important;
  max-width: none !important;
  flex: none !important;
  min-width: 0;
  padding: 0 !important;
  margin: 0 !important;
  text-align: left !important;
}

/* Entries without a date occupy full width */
.cv ul.list-group > li.list-group-item > .row > :only-child {
  grid-column: 1 / -1;
}

/* Date badge alignment */
.cv .table-cv {
  width: 100%;
  margin: 0 !important;
}

.cv .table-cv td {
  padding: 0 !important;
  border: 0 !important;
}

.cv .table-cv .badge {
  min-width: 96px !important;
  display: inline-flex;
  justify-content: center;
}

/* Location alignment */
.cv p.location {
  display: flex;
  align-items: flex-start;
  gap: 0.35rem;
  white-space: normal !important;
  text-align: left !important;
  font-size: 0.72rem;
  line-height: 1.4;
  margin: 0.3rem 0 0 !important;
}

.cv p.location i.iconlocation {
  flex-shrink: 0;
  margin-top: 0.15rem;
}

/* Align titles, institutions and details */
.cv ul.list-group > li.list-group-item > .row > div:last-child h6,
.cv ul.list-group > li.list-group-item > .row > div:last-child p {
  margin-left: 0 !important;
}

/* Keep highlight bullets indented consistently */
.cv ul.items {
  margin-left: 0 !important;
  padding-left: 1.25rem !important;
}

/* Mobile responsive layout */
@media (max-width: 575px) {
  .cv ul.list-group > li.list-group-item > .row {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.5rem;
  }
}
</style>
